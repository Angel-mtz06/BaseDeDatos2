SELECT * FROM CLIENTES ORDER BY CVECTE;
SELECT * FROM PRODUCTOS ORDER BY CVEART;
SELECT D.NOMBRE, S.NOMBRE FROM DEPARTAMENTOS D  INNER JOIN SUBDEPARTAMENTOS S ON D.ID = S.IDDEPTO  ORDER BY 1;
SELECT PERS_NOMBRE ||' '|| PERS_APEPAT ||' '|| PERS_APEMAT NOMBRE_COMPLETO FROM PERSONA ORDER BY NOMBRE_COMPLETO;
SELECT CL.NOMBRE,D.DESCRIPCION, D.CANTIDAD, D.PRECIO, D.IMPORTE FROM DETALLE D 
INNER JOIN CABECERA C ON D.IDCAB=C.IDCAB
INNER JOIN CLIENTES CL ON C.CVECTE=CL.CVECTE WHERE CL.CVECTE='CLIENTE';
SELECT SUM(TOTAL) FROM CABECERA;
SELECT P.NOMBRE, COUNT(*) FROM PRODUCTOS P INNER JOIN DETALLE D ON P.CVEART=D.CVEART GROUP BY P.NOMBRE
SELECT * FROM VENTAS WHERE FECHA BETWEEN '13/01/2005' AND '15/01/2005'
SELECT * FROM (
SELECT CVECTE, SUM(CANTIDADP) TOTALP FROM VENTAS GROUP BY CVECTE ORDER BY 2 DESC ) WHERE ROWNUM =1
SELECT * FROM VENTAS WHERE IMPORTE =(
SELECT MAX(IMPORTE) FROM VENTAS )
SELECT CVECTE,CANTIDADP FROM VENTAS WHERE CVECTE=1