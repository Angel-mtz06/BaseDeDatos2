DECLARE
    v_total NUMBER;
BEGIN
    SELECT total INTO v_total
    FROM cabecera
    WHERE cvecte = 999;  -- cliente que podría no existir

    DBMS_OUTPUT.PUT_LINE('Total: ' || v_total);

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('El cliente no existe.');
    WHEN TOO_MANY_ROWS THEN
        DBMS_OUTPUT.PUT_LINE('Error: más de un registro encontrado.');
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('Error desconocido: ' || SQLERRM);
END;
