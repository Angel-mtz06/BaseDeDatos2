CREATE OR REPLACE TRIGGER IVA_Calculo
AFTER INSERT ON VENTAS
FOR EACH ROW
BEGIN
    IF :NEW.IVA IS NULL THEN
        UPDATE VENTAS
        SET IVA = :NEW.IMPORTE * 0.16
        WHERE ID = :NEW.ID;
    END IF;
END;
---------------------------------------------------------------
CREATE OR REPLACE TRIGGER AUDITORIA_VENTAS
AFTER UPDATE OF PRECIO ON VENTAS
FOR EACH ROW
BEGIN
    INSERT INTO VENTAS_AUDITORIA(FECHA_UPDATE, ID_VENTA, PRECIO_ANTERIOR, PRECIO_NUEVO)
    VALUES (SYSDATE, :OLD.ID, :OLD.PRECIO, :NEW.PRECIO);
END;
---------------------------------------------------------------
CREATE OR REPLACE TRIGGER Calculo_Precio
AFTER UPDATE OF CANTIDADP, PRECIO ON VENTAS
FOR EACH ROW
BEGIN
    UPDATE VENTAS
    SET IMPORTE = :NEW.CANTIDADP * :NEW.PRECIO
    WHERE ID = :NEW.ID;
END;
---------------------------------------------------------------
CREATE OR REPLACE TRIGGER Auditoria_ventas_Delete
AFTER DELETE ON VENTAS
FOR EACH ROW
BEGIN
    INSERT INTO VENTAS_DELETE(FECHA_DELETE, ID_VENTA, CLIENTE, IMPORTE)
    VALUES (SYSDATE, :OLD.ID, :OLD.CLIENTE, :OLD.IMPORTE);
END;
---------------------------------------------------------------
CREATE OR REPLACE TRIGGER Revision_Inventario
AFTER DELETE ON VENTAS
FOR EACH ROW
BEGIN
    UPDATE VENTAS
    SET INVENTARIO = INVENTARIO + :OLD.CANTIDADP
    WHERE CVEART = :OLD.CVEART;
END;


