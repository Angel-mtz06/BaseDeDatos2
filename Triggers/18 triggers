create or replace trigger Validacion_Estados
  before update or insert on alumnos  
  for each row
declare
t_estados number;
begin
  SELECT COUNT(*)
  INTO t_estados
  FROM estados

  WHERE nombre = :new.estado_nacimiento;
  IF t_estados=0 THEN  
    RAISE_APPLICATION_ERROR(-2004,'Ese estado no es valido');
    end if;

end Validacion_Estados;
