CREATE OR REPLACE TRIGGER Pdatos_Insert
INSTEAD OF INSERT ON VPDATOS
FOR EACH ROW
BEGIN
    INSERT INTO PDATOS(PERS_ID, PES_NOM, APELLIDO_PAT, APELLIDO_MAT, PESR_CURP, PERS_FNACIO, SEXO, PERS_EDONACIO)
    VALUES (:NEW.PERS_ID, :NEW.PES_NOM, :NEW.APELLIDO_PAT, :NEW.APELLIDO_MAT, :NEW.PESR_CURP, :NEW.PERS_FNACIO, :NEW.SEXO, :NEW.PERS_EDONACIO);
END;
---------------------------------------------------------------
CREATE OR REPLACE TRIGGER Pdatos_Insert_Auditoria
INSTEAD OF INSERT ON VPDATOS
FOR EACH ROW
BEGIN
    INSERT INTO PDATOS(PERS_ID, PES_NOM, APELLIDO_PAT, APELLIDO_MAT, PESR_CURP, PERS_FNACIO, SEXO, PERS_EDONACIO)
    VALUES (:NEW.PERS_ID, :NEW.PES_NOM, :NEW.APELLIDO_PAT, :NEW.APELLIDO_MAT, :NEW.PESR_CURP, :NEW.PERS_FNACIO, :NEW.SEXO, :NEW.PERS_EDONACIO);

    INSERT INTO PDATOS_AUDITORIA_INSERT(PERS_ID, FECHA_INSERT)
    VALUES (:NEW.PERS_ID, SYSDATE);
END;
---------------------------------------------------------------
CREATE OR REPLACE TRIGGER Pdatos_Update
INSTEAD OF UPDATE ON VPDATOS
FOR EACH ROW
BEGIN
    UPDATE PDATOS
    SET PES_NOM = :NEW.PES_NOM,
        APELLIDO_PAT = :NEW.APELLIDO_PAT,
        APELLIDO_MAT = :NEW.APELLIDO_MAT,
        PESR_CURP = :NEW.PESR_CURP,
        PERS_FNACIO = :NEW.PERS_FNACIO,
        SEXO = :NEW.SEXO,
        PERS_EDONACIO = :NEW.PERS_EDONACIO
    WHERE PERS_ID = :OLD.PERS_ID;
END;
---------------------------------------------------------------
CREATE OR REPLACE TRIGGER Pdatos_Update_Auditoria
INSTEAD OF UPDATE ON VPDATOS
FOR EACH ROW
BEGIN
    UPDATE PDATOS
    SET PES_NOM = :NEW.PERS_NOM,
        APELLIDO_PAT = :NEW.APELLIDO_PAT,
        APELLIDO_MAT = :NEW.APELLIDO_MAT
    WHERE PERS_ID = :OLD.PERS_ID;

    INSERT INTO PDATOS_AUDITORIA_UPDATE(PERS_ID, NOMBRE_ANTERIOR, NOMBRE_NUEVO, FECHA_UPDATE)
    VALUES (:OLD.PERS_ID, :OLD.PERS_NOM, :NEW.PERS_NOM, SYSDATE);
END;
---------------------------------------------------------------
CREATE OR REPLACE TRIGGER Pdatos_Delete
INSTEAD OF DELETE ON VPDATOS
FOR EACH ROW
BEGIN
    DELETE FROM PDATOS
    WHERE PERS_ID = :OLD.PERS_ID;
END;
---------------------------------------------------------------
CREATE TABLE PDATOS_AUDITORIA_DELETE (
    PERS_ID NUMBER,
    FECHA_DELETE DATE
);

CREATE OR REPLACE TRIGGER Pdatos_Delete_Auditoria
INSTEAD OF DELETE ON VPDATOS
FOR EACH ROW
BEGIN
    DELETE FROM PDATOS
    WHERE PERS_ID = :OLD.PERS_ID;

    INSERT INTO PDATOS_AUDITORIA_DELETE(PERS_ID, FECHA_DELETE)
    VALUES (:OLD.PERS_ID, SYSDATE);
END;