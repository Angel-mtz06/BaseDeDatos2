--AFTER

---------------------------------------------------------------
CREATE OR REPLACE TRIGGER CURP
AFTER INSERT ON PDATOS
FOR EACH ROW
BEGIN
    IF TO_NUMBER(SUBSTR(:NEW.PESR_CURP, 5, 2)) < 25 THEN
        :NEW.PERS_FNACIO := TO_DATE('20' || SUBSTR(:NEW.PESR_CURP, 5, 2) ||
                                    SUBSTR(:NEW.PESR_CURP, 7, 2) ||
                                    SUBSTR(:NEW.PESR_CURP, 9, 2), 'YYYY/MM/DD');
    ELSE
        :NEW.PERS_FNACIO := TO_DATE('19' || SUBSTR(:NEW.PESR_CURP, 5, 2) ||
                                    SUBSTR(:NEW.PESR_CURP, 7, 2) ||
                                    SUBSTR(:NEW.PESR_CURP, 9, 2), 'YYYY/MM/DD');
    END IF;


    IF SUBSTR(:NEW.PESR_CURP, 11, 1) = 'H' THEN
        :NEW.SEXO := 'Hombre';
    ELSE
        :NEW.SEXO := 'Mujer';
    END IF;
END;
