-- Auditoría de INSERT
CREATE TABLE VENTAS_AUDITORIA_INSERT (
    FECHA_INSERT DATE,
    ID_VENTA INTEGER,
    CLIENTE VARCHAR2(80),
    IMPORTE NUMBER(18,2)
);

-- Auditoría de UPDATE de PRECIO
CREATE TABLE VENTAS_AUDITORIA_UPDATE (
    FECHA_UPDATE DATE,
    ID_VENTA INTEGER,
    PRECIO_ANTERIOR NUMBER(18,2),
    PRECIO_NUEVO NUMBER(18,2)
);

-- Auditoría de DELETE
CREATE TABLE VENTAS_AUDITORIA_DELETE (
    FECHA_DELETE DATE,
    ID_VENTA INTEGER,
    CLIENTE VARCHAR2(80),
    IMPORTE NUMBER(18,2)
);
CREATE TABLE PDATOS_AUDITORIA_INSERT (
    PERS_ID INTEGER,
    FECHA_INSERT DATE
);
CREATE TABLE PDATOS_AUDITORIA_UPDATE (
    PERS_ID INTEGER,
    NOMBRE_ANTERIOR VARCHAR2(50),
    NOMBRE_NUEVO VARCHAR2(50),
    FECHA_UPDATE DATE
);
CREATE TABLE PDATOS_AUDITORIA_DELETE (
    PERS_ID INTEGER,
    FECHA_DELETE DATE
);
CREATE TABLE PDATOS_ELIMINADOS (
    PERS_ID INTEGER,
    PES_NOM VARCHAR2(50),
    APELLIDO_PAT VARCHAR2(50),
    APELLIDO_MAT VARCHAR2(50),
    PESR_CURP VARCHAR2(50),
    PERS_FNACIO DATE,
    SEXO VARCHAR2(20),
    PERS_EDONACIO VARCHAR2(2),
    FECHA_ELIMINACION DATE,
    USUARIO_ELIMINO VARCHAR2(30)
);
CREATE OR REPLACE VIEW VPDATOS AS
SELECT PERS_ID, PES_NOM, APELLIDO_PAT, APELLIDO_MAT, PESR_CURP, PERS_FNACIO, SEXO, PERS_EDONACIO
FROM PDATOS;
