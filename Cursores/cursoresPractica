Declare
 CURSOR CURCLIENTES IS 
 SELECT CVECTE,NOMBRE FROM CLIENTES ;
 CID CLIENTES.CVECTE%TYPE;
 CNOMBRE CLIENTES.NOMBRE%TYPE;
begin
  OPEN CURCLIENTES;
  LOOP
    FETCH CURCLIENTES INTO CID,CNOMBRE;
     EXIT WHEN CURCLIENTES%NOTFOUND;
     DBMS_OUTPUT.ENABLE(buffer_size => 1000000);
    DBMS_OUTPUT.put_line(CID||CNOMBRE);
   
  
  
    END LOOP;
  
end;


declare
CURSOR CURPRODUCTOS IS 
SELECT P.CVEART,P.NOMBRE,P.PRECIO FROM PRODUCTOS P;
ID PRODUCTOS.CVEART%TYPE;
CNOMBRE PRODUCTOS.NOMBRE%TYPE;
CPRECIO PRODUCTOS.PRECIO%TYPE;
begin
  OPEN CURPRODUCTOS; 
  LOOP
    FETCH CURPRODUCTOS INTO  ID, CNOMBRE,CPRECIO;
     EXIT WHEN CURPRODUCTOS%NOTFOUND;
          DBMS_OUTPUT.ENABLE(buffer_size => 1000000);
     DBMS_OUTPUT.put_line(ID||CNOMBRE||CPRECIO);
    END LOOP;

  end;

DECLARE
CURSOR CURVENTAS IS
SELECT V.FECHA,V.CANTIDADP, V.PRECIO FROM VENTAS V WHERE V.CVECTE =1;
CFECHA VENTAS.FECHA%TYPE;
CCANTIDAD VENTAS.CANTIDADP%TYPE;
CPRECIO   VENTAS.PRECIO%TYPE;
BEGIN
  OPEN CURVENTAS;
  
  LOOP
      FETCH CURVENTAS INTO CFECHA,CCANTIDAD,CPRECIO;
       EXIT WHEN CURVENTAS%NOTFOUND;
       DBMS_OUTPUT.put_line(CFECHA||' '||CCANTIDAD*CPRECIO);
  
    END LOOP;
    

  END;